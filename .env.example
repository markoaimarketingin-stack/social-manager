# Social Community Manager - Environment Variables Template

# ===== CORE CONFIGURATION =====

# FastAPI server port
PORT=8088

# Database URL (sqlite for development, postgresql for production)
SOCIAL_MANAGER_DB_URL=sqlite:///./social_manager.db

# ===== LLM CONFIGURATION =====

# Groq API key for LLM operations
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# ===== REAL FEATURES API KEYS =====

# NewsAPI key for real trend monitoring
# Get from: https://newsapi.org (free tier: 100 requests/day)
# Leave blank to use demo trends
NEWSAPI_KEY=your_newsapi_key_here

# OpenAI API key for DALL-E image generation
# Get from: https://platform.openai.com/api-keys (free $5 credits)
# Leave blank to use placeholder images
OPENAI_API_KEY=sk_your_openai_key_here

# SendGrid API key for email campaigns
# Get from: https://sendgrid.com/free (free tier: 100 emails/day)
# Leave blank to log emails to console
SENDGRID_API_KEY=SG.your_sendgrid_key_here

# Email sender address for SendGrid
EMAIL_FROM=noreply@socialmanager.ai

# ===== OPTIONAL PLATFORM CREDENTIALS =====

# Instagram Business Account
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Facebook Page
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# X/Twitter API
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# YouTube
YOUTUBE_API_KEY=

# ===== OPTIONAL INTEGRATIONS =====

# Mailchimp API
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# HubSpot
HUBSPOT_API_KEY=

# Shopify (for e-commerce)
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=

# Google Analytics
GOOGLE_ANALYTICS_API_KEY=

# ===== DEPLOYMENT =====

# CORS allowed origins (comma-separated for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8088,https://yourdomain.com
