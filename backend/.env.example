# Social Community Manager - Environment Variables Template
# Copy this file to .env and fill in your real values

# ===== CORE CONFIGURATION =====

# FastAPI server port
PORT=8088

# Database URL (sqlite for development, postgresql for production)
SOCIAL_MANAGER_DB_URL=sqlite:///./social_manager.db
# SOCIAL_MANAGER_DB_URL=sqlite:///./social_manager.db

# ===== LLM CONFIGURATION =====

# Groq API key for LLM operations
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ===== REAL FEATURES API KEYS =====

# NewsAPI key for real trend monitoring
# Get from: https://newsapi.org (free tier: 100 requests/day)
NEWSAPI_KEY=your_newsapi_key_here

# OpenAI API key for DALL-E image generation
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# SendGrid API key for email campaigns
# Get from: https://sendgrid.com/free (free tier: 100 emails/day)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Email sender address for SendGrid
EMAIL_FROM=noreply@socialmanager.ai

# ===== OPTIONAL PLATFORM CREDENTIALS =====

# Instagram Business Account
# Get from: Meta Developer Portal -> your app -> Graph API Explorer
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_page_access_token

# Facebook Page
# Get from: Meta Developer Portal -> Graph API Explorer (use Page token, not User token)
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token

# Meta App credentials (needed for OAuth flow)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# LinkedIn
# Get from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# X/Twitter API
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key

# ===== OPTIONAL INTEGRATIONS =====

# Mailchimp API
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# HubSpot
HUBSPOT_API_KEY=

# Shopify (for e-commerce)
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=

# Google Analytics
GOOGLE_ANALYTICS_API_KEY=

# ===== DEPLOYMENT =====

# CORS allowed origins (comma-separated for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8088,https://yourdomain.com
